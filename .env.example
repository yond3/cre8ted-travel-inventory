# Copy to .env at the project root and fill in values for your machine.
# Real OS / container environment variables always win over this file.
# .env is gitignored — never commit secrets.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cre8ted_inventory
DB_USER=root
DB_PASSWORD=

FORECAST_SERVICE_URL=http://127.0.0.1:5050
OCR_SERVICE_URL=http://127.0.0.1:5051

# stub = auto-approve locally (default). live = POST to FINANCE_API_BASE_URL.
FINANCE_MODE=stub
FINANCE_API_BASE_URL=http://127.0.0.1:9090/finance/api
FINANCE_API_KEY=
FINANCE_WEBHOOK_SECRET=dev-finance-webhook-secret
APP_BASE_URL=http://127.0.0.1:8000

# Browser origins allowed in addition to the API's own origin and APP_BASE_URL.
# Comma-separated exact origins (scheme + hostname + optional port), never '*'.
# Leave blank for the existing same-origin app. This does not replace login/CSRF.
# Unrelated-site session cookies remain subject to the existing SameSite=Lax rule.
CORS_ALLOWED_ORIGINS=

# Phase 6: set independently for each environment; keep key outside public PHP root.
# Generate a secure random 32-byte value, Base64 encode, and back it up separately.
MFA_ENCRYPTION_KEY=
# Set 1 before enforced rollout so missing schema never falls back to preparation.
MFA_SCHEMA_REQUIRED=0
# Default is HTTPS-only. Enable only for a loopback development server.
MFA_ALLOW_LOCAL_HTTP=0
# Optional HTTP deployment compatibility. Exact origin only: scheme + host + port.
# Keep disabled/blank for HTTPS. No paths, wildcards, or comma-separated lists.
MFA_ALLOW_HTTP=0
MFA_HTTP_ORIGIN=
MFA_ISSUER=Cre8ted Inventory
# Successful credential attempts in five minutes before another challenge is refused.
MFA_CHALLENGES_PER_USER=10
MFA_CHALLENGES_PER_IP=60
