# Copy to .env at the project root and fill in values for your machine.
# Real OS / container environment variables always win over this file.
# .env is gitignored — never commit secrets.

DB_HOST=127.0.0.1
DB_NAME=cre8ted_inventory
DB_USER=root
DB_PASSWORD=

FORECAST_SERVICE_URL=http://127.0.0.1:5050
OCR_SERVICE_URL=http://127.0.0.1:5051

# stub = auto-approve locally (default). live = POST to FINANCE_API_BASE_URL.
FINANCE_MODE=stub
FINANCE_API_BASE_URL=http://127.0.0.1:9090/finance/api
FINANCE_API_KEY=
FINANCE_WEBHOOK_SECRET=dev-finance-webhook-secret
APP_BASE_URL=http://127.0.0.1:8000
