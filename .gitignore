# Node (local tooling e.g. puppeteer for BPMN PNG export)
node_modules/

# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local secrets / env
.env
.env.*
!.env.example

# Local database/receipt backups contain private application data.
/backups/

# Old SQLite demo (app uses MySQL now)
inventory.db
archive/inventory.db
*.db

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/

# Local project documentation (report / thesis — not part of the app repo)
docs/
scripts/

# Uploaded files (keep folder only)
php/uploads/receipts/*
!php/uploads/receipts/.gitkeep

# Local cookie jars from curl / test scripts
php/cookies.txt
php/cookies*.txt

# Runtime deployment state must never be committed.
/php/api/.inventory-maintenance

# Isolated Phase 5 working copy; never served by the normal PHP root.
/phase5-development/

# Isolated Phase 6 development; normal PHP root is unchanged.
/phase6-development/

# Composer runtime/cache; commit composer.json and composer.lock only.
/vendor/
/tools/
